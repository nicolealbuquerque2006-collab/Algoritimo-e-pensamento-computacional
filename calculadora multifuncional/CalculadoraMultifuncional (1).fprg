<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Calculadora Multifuncional"/>
        <attribute name="authors" value="Roberto"/>
        <attribute name="about" value="Trabalho de Tecnologia da Informacao - Calculadora Multifuncional com menu de 11 opcoes"/>
        <attribute name="saved" value="2026-08-25 06:05:16 "/>
        <attribute name="created" value=""/>
        <attribute name="edited" value=""/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLTBMQUg4SjY7MjAyNi0wOC0yNTsiMDY6MDU6MTYgIjs0OzI3NTI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <declare name="n1, n2, n3, resultado" type="Real" array="False" size=""/>
            <declare name="base, expoente" type="Real" array="False" size=""/>
            <declare name="raio" type="Real" array="False" size=""/>
            <declare name="baseRet, alturaRet" type="Real" array="False" size=""/>
            <declare name="celsius" type="Real" array="False" size=""/>
            <assign variable="opcao" expression="0"/>
            <while expression="opcao&lt;&gt;11">
                <output expression="&quot;        CALCULADORA MULTIFUNCIONAL&quot;" newline="True"/>
                <output expression="&quot;1  - Soma&quot;" newline="True"/>
                <output expression="&quot;2  - Subtra&#231;&#227;o&quot;" newline="True"/>
                <output expression="&quot;3  - Multiplica&#231;&#227;o&quot;" newline="True"/>
                <output expression="&quot;4  - Divis&#227;o&quot;" newline="True"/>
                <output expression="&quot;5  - Potencia&#231;&#227;o&quot;" newline="True"/>
                <output expression="&quot;6  - Raiz Quadrada&quot;" newline="True"/>
                <output expression="&quot;7  - &#193;rea do C&#237;rculo&quot;" newline="True"/>
                <output expression="&quot;8  - &#193;rea do Ret&#226;ngulo&quot;" newline="True"/>
                <output expression="&quot;9  - Convers&#227;o de Celsius para Fahrenheit&quot;" newline="True"/>
                <output expression="&quot;10 - M&#233;dia Aritm&#233;tica&quot;" newline="True"/>
                <output expression="&quot;11 - Encerrar o Programa&quot;" newline="True"/>
                <output expression="&quot;Escolha uma op&#231;&#227;o (1 a 11): &quot;" newline="True"/>
                <input variable="opcao"/>
                <if expression="opcao=1">
                    <then>
                        <output expression="&quot;--- Op&#231;&#227;o 1: Soma ---&quot;" newline="True"/>
                        <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
                        <input variable="n1"/>
                        <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
                        <input variable="n2"/>
                        <assign variable="resultado" expression="n1+n2"/>
                        <output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; + &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                    </then>
                    <else>
                        <if expression="opcao=2">
                            <then>
                                <output expression="&quot;Op&#231;&#227;o 2: Subtra&#231;&#227;o&quot;" newline="True"/>
                                <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
                                <input variable="n1"/>
                                <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
                                <input variable="n2"/>
                                <assign variable="resultado" expression="n1-n2"/>
                                <output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; - &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                            </then>
                            <else>
                                <if expression="opcao=3">
                                    <then>
                                        <output expression="&quot;Op&#231;&#227;o 3: Multiplica&#231;&#227;o&quot;" newline="True"/>
                                        <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
                                        <input variable="n1"/>
                                        <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
                                        <input variable="n2"/>
                                        <assign variable="resultado" expression="n1*n2"/>
                                        <output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; * &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="opcao=4">
                                            <then>
                                                <output expression="&quot;Op&#231;&#227;o 4: Divis&#227;o&quot;" newline="True"/>
                                                <output expression="&quot;Digite o numerador:&quot;" newline="True"/>
                                                <input variable="n1"/>
                                                <output expression="&quot;Digite o denominador:&quot;" newline="True"/>
                                                <input variable="n2"/>
                                                <if expression="n2=0">
                                                    <then>
                                                        <output expression="&quot;Erro: n&#227;o &#233; poss&#237;vel dividir por zero!&quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <assign variable="resultado" expression="n1/n2"/>
                                                        <output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; / &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                                                    </else>
                                                </if>
                                            </then>
                                            <else>
                                                <if expression="opcao=5">
                                                    <then>
                                                        <output expression="&quot;Op&#231;&#227;o 5: Potencia&#231;&#227;o&quot;" newline="True"/>
                                                        <output expression="&quot;Digite a base:&quot;" newline="True"/>
                                                        <input variable="base"/>
                                                        <output expression="&quot;Digite o expoente:&quot;" newline="True"/>
                                                        <input variable="expoente"/>
                                                        <assign variable="resultado" expression="base^expoente"/>
                                                        <output expression="&quot;Resultado: &quot; &amp; base &amp; &quot; ^ &quot; &amp; expoente &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="opcao=6">
                                                            <then>
                                                                <output expression="&quot;Op&#231;&#227;o 6: Raiz Quadrada&quot;" newline="True"/>
                                                                <output expression="&quot;Digite o n&#250;mero:&quot;" newline="True"/>
                                                                <input variable="n1"/>
                                                                <if expression="n1&lt;0">
                                                                    <then>
                                                                        <output expression="&quot;Erro: n&#227;o existe raiz quadrada real de n&#250;mero negativo!&quot;" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <assign variable="resultado" expression="Sqrt(n1)"/>
                                                                        <output expression="&quot;Resultado: raiz quadrada de &quot; &amp; n1 &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                                                                    </else>
                                                                </if>
                                                            </then>
                                                            <else>
                                                                <if expression="opcao=7">
                                                                    <then>
                                                                        <output expression="&quot;Op&#231;&#227;o 7: &#193;rea do C&#237;rculo&quot;" newline="True"/>
                                                                        <output expression="&quot;Digite o raio:&quot;" newline="True"/>
                                                                        <input variable="raio"/>
                                                                        <assign variable="resultado" expression="pi*(raio^2)"/>
                                                                        <output expression="&quot;Resultado: &#225;rea do c&#237;rculo de raio &quot; &amp; raio &amp; &quot; = &quot; &amp; resultado" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <if expression="opcao=8">
                                                                            <then>
                                                                                <output expression="&quot;Op&#231;&#227;o 8: &#193;rea do Ret&#226;ngulo&quot;" newline="True"/>
                                                                                <output expression="&quot;Digite a base do ret&#226;ngulo:&quot;" newline="True"/>
                                                                                <input variable="baseRet"/>
                                                                                <output expression="&quot;Digite a altura do ret&#226;ngulo:&quot;" newline="True"/>
                                                                                <input variable="alturaRet"/>
                                                                                <assign variable="resultado" expression="baseRet*alturaRet"/>
                                                                                <output expression="&quot;Resultado: &#225;rea do ret&#226;ngulo = &quot; &amp; resultado" newline="True"/>
                                                                            </then>
                                                                            <else>
                                                                                <if expression="opcao=9">
                                                                                    <then>
                                                                                        <output expression="&quot;Op&#231;&#227;o 9: Convers&#227;o Celsius para Fahrenheit&quot;" newline="True"/>
                                                                                        <output expression="&quot;Digite a temperatura em graus Celsius:&quot;" newline="True"/>
                                                                                        <input variable="celsius"/>
                                                                                        <assign variable="resultado" expression="(celsius*9/5)+32"/>
                                                                                        <output expression="&quot;Resultado: &quot; &amp; celsius &amp; &quot; C = &quot; &amp; resultado &amp; &quot; F&quot;" newline="True"/>
                                                                                    </then>
                                                                                    <else>
                                                                                        <if expression="opcao=10">
                                                                                            <then>
                                                                                                <output expression="&quot;Op&#231;&#227;o 10: M&#233;dia Aritm&#233;tica&quot;" newline="True"/>
                                                                                                <output expression="&quot;Digite o primeiro n&#250;mero:&quot;" newline="True"/>
                                                                                                <input variable="n1"/>
                                                                                                <output expression="&quot;Digite o segundo n&#250;mero:&quot;" newline="True"/>
                                                                                                <input variable="n2"/>
                                                                                                <output expression="&quot;Digite o terceiro n&#250;mero:&quot;" newline="True"/>
                                                                                                <input variable="n3"/>
                                                                                                <assign variable="resultado" expression="(n1+n2+n3)/3"/>
                                                                                                <output expression="&quot;Resultado: a m&#233;dia de &quot; &amp; n1 &amp; &quot;, &quot; &amp; n2 &amp; &quot; e &quot; &amp; n3 &amp; &quot; &#233; = &quot; &amp; resultado" newline="True"/>
                                                                                            </then>
                                                                                            <else>
                                                                                                <if expression="opcao=11">
                                                                                                    <then>
                                                                                                        <output expression="&quot;Encerrando o programa. At&#233; a pr&#243;xima!&quot;" newline="True"/>
                                                                                                    </then>
                                                                                                    <else>
                                                                                                        <output expression="&quot;Op&#231;&#227;o inv&#225;lida! Digite um n&#250;mero entre 1 e 11.&quot;" newline="True"/>
                                                                                                    </else>
                                                                                                </if>
                                                                                            </else>
                                                                                        </if>
                                                                                    </else>
                                                                                </if>
                                                                            </else>
                                                                        </if>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <output expression="&quot;Programa encerrado.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
